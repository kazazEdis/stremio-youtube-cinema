node_modules/

# build output — regenerated every run, only docs/ is committed
out/

# IMDb datasets and derived index. ~2GB of third-party data under a
# non-commercial licence. Never commit.
.cache/
*.tsv
*.tsv.gz
*.sqlite
# SQLite's WAL sidecars do not end in .sqlite, so the pattern above misses
# them. They exist whenever a connection is open, which includes the moment a
# CI job or a killed process leaves one behind.
*.sqlite-wal
*.sqlite-shm

# The warehouse. Staging and core are rebuildable from landing; landing is
# rebuildable only by spending API quota, so it is preserved by the Actions
# cache rather than by git -- it is far too large and too churny to commit.
data/

.env
.DS_Store

# Regional addon trees: 20 of them, 66,000 files, 280 MB, and ~85% identical to
# the root. They are built in CI and deployed straight to Pages as an artifact,
# so the repo carries only the unrestricted tree — which stays diffable, and is
# what the weekly "catalog: N films" commit is actually about.
docs/region=*/
